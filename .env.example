# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
# Reddit "script" app from https://www.reddit.com/prefs/apps (only for 02_collect.py --sources reddit)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=linux:hamtube:0.1 (by /u/yourname)
# Optional overrides
# CLASSIFY_MODEL=claude-sonnet-5-5
# DESCRIBE_MODEL=claude-opus-5-5
# HAMTUBE_FALLBACKS=1   # set 0 to disable the server-side refusal fallback
